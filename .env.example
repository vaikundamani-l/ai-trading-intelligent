# Delta Exchange India Public API Configuration
DELTA_REST_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://public-socket.india.delta.exchange
SYMBOL=BTCUSD

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
DB_PATH=/app/data/btc_quantum.db
ENVIRONMENT=production

# Security & Access Control
# Comma-separated list of allowed Host headers (required for reverse proxies/domains)
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,gateway
# Comma-separated list of allowed browser CORS & WebSocket origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://127.0.0.1
# Optional API authentication token to protect mutating trading endpoints (leave empty for open local dev)
API_AUTH_TOKEN=
ENABLE_SECURITY_HEADERS=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=
# Leave NEXT_PUBLIC_WS_URL empty for auto-detection (routes to host /ws in production or port 8000 in dev)
NEXT_PUBLIC_WS_URL=
BACKEND_INTERNAL_URL=http://backend:8000
