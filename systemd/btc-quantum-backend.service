[Unit]
Description=BTC Quantum Intelligence Backend Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shadow-khan
Group=shadow-khan
WorkingDirectory=/home/shadow-khan/ai-trading-intelligent/backend
Environment=PYTHONPATH=/home/shadow-khan/ai-trading-intelligent/backend
EnvironmentFile=-/home/shadow-khan/ai-trading-intelligent/.env
ExecStart=/home/shadow-khan/myenv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3s
KillMode=process
TimeoutStopSec=15
LimitNOFILE=65536

# Security Hardening
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/shadow-khan/ai-trading-intelligent/backend/data /home/shadow-khan/ai-trading-intelligent/logs /home/shadow-khan/ai-trading-intelligent/backups

[Install]
WantedBy=multi-user.target
